# ============================================================
# ALNOKHBA QB — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# --- REQUIRED -------------------------------------------------

# Database (SQLite file, relative to project root in dev;
# use an absolute path in production standalone deployments).
# For PostgreSQL: postgresql://user:pass@host:5432/alnokhbaqb
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# JWT signing secret for authentication (min 32 chars).
# Generate:  openssl rand -base64 48
AUTH_SECRET="change-me-generate-a-strong-random-secret-32ch+"

# --- OPTIONAL -------------------------------------------------

# Chrome/Chromium binary for the PDF engine (vector exam PDFs +
# OMR sheet rendering). Leave empty to auto-discover, in order:
#   1. ./chrome/chrome-headless-shell/linux-*/…   (bundled via `bun run chrome:install`)
#   2. $PUPPETEER_CACHE_DIR / ~/.cache/puppeteer
# Docker image: already set to /usr/bin/chromium (no need to touch).
# CHROME_PATH="/usr/bin/chromium"

# Root of a puppeteer browser cache to search (before home caches).
# PUPPETEER_CACHE_DIR=""

# OMR/OCR Python engine base URL (mini-services/omr-engine).
# Default: http://127.0.0.1:3032
# OMR_ENGINE_URL="http://127.0.0.1:3032"
