# ============================================================
# ALNOKHBA QB — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# --- REQUIRED -------------------------------------------------

# Database (SQLite file, relative to project root in dev;
# use an absolute path in production standalone deployments).
# For PostgreSQL: postgresql://user:pass@host:5432/alnokhbaqb
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# JWT signing secret for authentication (min 32 chars).
# Generate:  openssl rand -base64 48
AUTH_SECRET="change-me-generate-a-strong-random-secret-32ch+"

# --- AI BACKEND (smart extraction / question generation / OCR-VLM) ------------

# The app calls an OpenAI-compatible chat API. Any provider works:
#   OpenAI          AI_BASE_URL="https://api.openai.com/v1"            model gpt-4o-mini
#   OpenRouter      AI_BASE_URL="https://openrouter.ai/api/v1"         model google/gemini-2.0-flash-001
#   Google Gemini   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"  model gemini-3.8-flash
#   Z.ai public     AI_BASE_URL="https://api.z.ai/api/paas/v4"         model glm-4.5v
#   Groq / Together / Ollama / vLLM … — anything exposing /chat/completions
#
# CURRENT PRODUCTION SETUP (Groq — key format "gsk_…"):
#   AI_API_KEY="gsk_…"
#   AI_BASE_URL="https://api.groq.com/openai/v1"
#   AI_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
#   AI_CHAT_MODEL="llama-3.3-70b-versatile"
#   AI_MODEL="llama-3.3-70b-versatile"
#   AI_FALLBACK_MODEL="meta-llama/llama-4-maverick-17b-128e-instruct"
# Vision notes: llama-4-scout / llama-4-maverick are Groq's vision models;
# llama-3.3-70b-versatile is the strong text-only chat model.
# (Previous attempt: Gemini AI Studio key "AQ.…" — 403 region-blocked from
# some hosts; Groq served from US regions works.)
#
# REQUIRED on Vercel (the built-in dev endpoint is private to the Z.ai
# sandbox and unreachable from serverless hosts). Leave unset locally to
# use the built-in sandbox model.
# AI_API_KEY="sk-…"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_VISION_MODEL="gpt-4o-mini"   # vision-capable (extraction/OCR/transcription)
# AI_CHAT_MODEL="gpt-4o-mini"     # text-only (question generation, doc tools)
# AI_MODEL="gpt-4o-mini"          # fallback for both when the above are unset

# --- OPTIONAL -------------------------------------------------

# Chrome/Chromium binary for the PDF engine (vector exam PDFs +
# OMR sheet rendering). Leave empty to auto-discover, in order:
#   1. ./chrome/chrome-headless-shell/linux-*/…   (bundled via `bun run chrome:install`)
#   2. $PUPPETEER_CACHE_DIR / ~/.cache/puppeteer
# Docker image: already set to /usr/bin/chromium (no need to touch).
# CHROME_PATH="/usr/bin/chromium"

# Root of a puppeteer browser cache to search (before home caches).
# PUPPETEER_CACHE_DIR=""

# OMR/OCR Python engine base URL (mini-services/omr-engine).
# Default: http://127.0.0.1:3032
# OMR_ENGINE_URL="http://127.0.0.1:3032"

# --- SCAN UPLOAD LIMITS (optional) --------------------------------------------

# Max single sheet image upload (MB). Default: 25
# SCAN_MAX_IMAGE_MB=25
# Max PDF upload size (MB). Default: 40 — tighten to 25 on constrained hosts
# SCAN_MAX_PDF_MB=40
# Max pages per PDF batch scan. Default: 200 — tighten to 30 on slow hosts
# SCAN_MAX_PDF_PAGES=200
# Rasterization DPI for PDF pages before OMR (engine clamps 72..300). Default: 300
# SCAN_PDF_DPI=300
