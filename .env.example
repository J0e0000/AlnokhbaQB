# ALNOKHBA QB — environment variables (names only; NEVER commit real values)

# ---- Database ----
# Local dev: sqlite file. Production (Vercel): Supabase Postgres —
# DATABASE_URL = the POOLED connection (Supabase transaction pooler, append
# ?pgbouncer=true); DIRECT_URL = the direct 5432 connection (migrations/db push).
DATABASE_URL="file:./db/custom.db"
DIRECT_URL=

# ---- Auth gate (shared password; see src/proxy.ts) ----
# APP_PASSWORD: the app password. SESSION_SECRET: >=32 chars, used to HMAC-sign
# session cookies. Both unset → the gate runs fail-open (site usable, no auth).
APP_PASSWORD=
SESSION_SECRET=

# ---- OMR engine (mini-services/omr-engine, see its DEPLOY.md) ----
OMR_ENGINE_URL=http://127.0.0.1:3032
# Bearer token required by the engine on every route except GET /health;
# the engine refuses to bind 0.0.0.0 without it.
OMR_ENGINE_TOKEN=

# ---- Supabase Storage (assignment submissions; server-side only) ----
# Service-role key must never be exposed to the client. Unset → the legacy
# local-disk submission flow is used instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
